@startuml StateMachine
title Masina de Stari - Aquatlantis Smart Aquarium Controller

[*] --> MODE_DAY : Pornire Sistem (Fallback Implicit)

state "MOD NORMAL - ZI" as MODE_DAY {
    MODE_DAY : Relee evaluate conform orar individual
}

state "MOD NORMAL - NOAPTE" as MODE_NIGHT {
    MODE_NIGHT : Relee evaluate conform orar individual
}

MODE_DAY --> MODE_NIGHT : Orar Pompă Aer activ (NTP Sincronizat)
MODE_NIGHT --> MODE_DAY : Orar Pompă Aer inactiv / Nesincronizat NTP

@enduml
